// ════════════════════════════════════════════════════════════════════════
//  LOCAL DEV MIRROR — SQLite  (DO NOT deploy this to production)
// ════════════════════════════════════════════════════════════════════════
//  This is the SQLite equivalent of prisma/schema.prisma (PostgreSQL).
//  It exists ONLY so the local dev server can run against a SQLite file
//  (local .env has DATABASE_URL=file:./db/custom.db).
//
//  ⚠️  NEVER copy this file over prisma/schema.prisma and commit it.
//      Use `bash scripts/local-db-push.sh` which swaps + restores safely.
//
//  When adding a new model/column: update BOTH this file AND
//  prisma/schema.prisma (the postgres production schema) so they stay
//  in sync. The ONLY differences should be:
//    - provider: "sqlite" vs "postgresql"
//    - no @db.Text annotations (sqlite ignores them)
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   // bcrypt hash for credentials auth
  image         String?
  role          String    @default("user")  // "user" | "admin"
  tokens        Int       @default(0)      // credit/token balance
  isActive      Boolean   @default(true)
  // ── Free Preview rate-limiting (resets daily) ──
  // previewDate is the YYYY-MM-DD of the current usage window.
  // When it doesn't match today, counters reset to 0.
  previewDate             String?  // YYYY-MM-DD
  previewStoryboardCount  Int      @default(0)  // max 10/day
  previewImageCount       Int      @default(0)  // max 3/day
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      VideoProject[]
  payments      Payment[]
  transactions  TokenTransaction[]
  brandKit      BrandKit?
  socialConnections SocialConnection[]
  workspaces    WorkspaceMember[]
}

model VideoProject {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  style          String     @default("cinematic")
  aspectRatio    String     @default("16:9")
  status         String     @default("draft")
  targetDuration  Int        @default(60)
  projectType    String     @default("custom")   // custom, birthday, commercial, event, social
  finalVideoUrl  String?
  // ── Sharing ──
  shareSlug      String?    @unique  // public share URL slug
  isPublic       Boolean    @default(false)  // visible on public share page
  sharePassword  String?    // bcrypt hash; null = no password
  allowEmbed     Boolean    @default(true)   // allow iframe embedding
  // ── Brand Kit ──
  brandKitId     String?
  brandKit       BrandKit?  @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  // ── Workspace ──
  workspaceId    String?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  scenes         VideoScene[]
  characters     Character[]
  views          VideoView[]
  socialPosts    SocialPublish[]
  @@index([userId])
  @@index([shareSlug])
}

model VideoScene {
  id             String   @id @default(cuid())
  projectId      String
  project        VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneNumber    Int
  title          String?
  prompt         String
  enhancedPrompt String?
  visualNote     String?
  dialogue       String?
  characterIds   String?
  referenceImageUrl String?
  narrationUrl   String?
  narrationVoice String?                       // which TTS voice was used
  mood           String?                       // emotional mood of the scene (dramatic, happy, dark, etc.)
  cameraMove     String?                       // camera movement directive (zoom_in, pan_left, tracking, etc.)
  lighting       String?                       // lighting style (golden hour, neon glow, studio lighting, etc.)
  musicMood      String?                       // background music mood (epic, calm, tense, joyful)
  musicTrackUrl  String?                       // selected background music file URL
  musicVolume    Int       @default(30)         // 0-100 background music volume level
  // ── Subtitles ──
  subtitleSrt    String?                       // SRT format subtitle text
  subtitleStatus String?                       // "pending" | "generating" | "ready" | "failed"
  subtitleLang   String?                       // language code (en, fr, twi, etc.)
  burnSubtitles  Boolean   @default(false)     // burn subtitles into exported video
  // ── Dubbing / Translation ──
  narrationLang  String?                       // language of the narration (en, fr, twi, etc.)
  imageUrl       String?
  imageBase64    String?
  videoUrl       String?
  taskId         String?
  duration       Int      @default(10)
  transition     String   @default("fade")
  status         String   @default("pending")
  errorMessage   String?                        // why generation failed (rate_limit, server, etc.)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  translations   SceneTranslation[]
  @@index([projectId])
}

model Character {
  id             String   @id @default(cuid())
  projectId      String
  project        VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  role           String?                       // protagonist, supporting, narrator, background
  description    String?
  stylePrompt    String?
  voiceId        String?                       // assigned TTS voice ID for this character
  imageUrl       String?
  imageBase64    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  @@index([projectId])
}

model GenerationHistory {
  id          String   @id @default(cuid())
  prompt      String
  inputType   String   @default("text")
  style       String?
  createdAt   DateTime @default(now())
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway         String    // "paystack" | "hubtel" | "stripe"
  gatewayRef      String?   // reference/transaction ID from payment gateway
  amount          Float     // amount paid
  currency        String    @default("GHS")  // "GHS" | "USD"
  tokensPurchased Int       // number of tokens bought
  status          String    @default("pending")  // "pending" | "completed" | "failed" | "refunded"
  metadata        String?   // JSON string for gateway-specific data
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([userId])
}

model TokenTransaction {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String    // "purchase" | "spend" | "refund" | "bonus"
  amount        Int       // positive = credit, negative = debit
  description   String
  referenceId   String?   // payment ID or project ID
  // ── Cost tracking for profit analytics ──
  // The real cost in USD that Z.ai charged YOU for this operation.
  // Only populated for "spend" transactions (generation operations).
  // Revenue (from Payment.amount) minus sum(costUsd) = your gross profit.
  costUsd       Float?    // actual Z.ai API cost for this operation (USD)
  operationType String?   // "video_gen" | "image_gen" | "llm" | "tts" | "asr" | "download" | "purchase"
  createdAt     DateTime  @default(now())
  @@index([userId])
  @@index([type])
  @@index([operationType])
}

model SystemConfig {
  id            String    @id @default(cuid())
  key           String    @unique
  value         String
  description   String?
  updatedAt     DateTime  @updatedAt
}

// ── Admin-managed token packages ──
// Stored in DB so the admin can adjust prices, quantities, bonuses, and
// ordering WITHOUT a code change or redeploy. Seeds mirror the hardcoded
// defaults in src/lib/pricing.ts (TOKEN_PACKAGES) for migration safety.
model TokenPackage {
  id            String    @id @default(cuid())
  // Human-readable slug kept stable across renames (e.g. "starter", "basic").
  // Used by the checkout flow to reference a package after an admin rename.
  slug          String    @unique
  name          String
  tokens        Int                       // base token count
  priceGHS      Float
  priceUSD      Float
  bonusPct      Float     @default(0)     // extra tokens as % (e.g. 20 = +20%)
  popular       Boolean   @default(false) // highlighted in the buy-tokens grid
  isActive      Boolean   @default(true)  // soft-delete / hide from storefront
  sortOrder     Int       @default(0)     // ascending; lower = shown first
  features      String    @default("[]")  // JSON array of feature strings
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([isActive, sortOrder])
}

// ════════════════════════════════════════════════════════════════
// ADVANCED FEATURES SCHEMA
// ════════════════════════════════════════════════════════════════

// ── Brand Kit: per-user branding for watermarking exports ──
model BrandKit {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName     String
  logoUrl       String?   // uploaded logo file URL (/uploads/brand-*.png)
  logoPosition  String    @default("bottom-right")  // top-left, top-right, bottom-left, bottom-right, center
  logoOpacity   Int       @default(80)  // 0-100
  logoScale     Int       @default(15)  // percentage of video width
  primaryColor  String?   // hex color, e.g. #6d28d9
  tagline       String?
  website       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      VideoProject[]
}

// ── Scene Translation: for multi-language dubbing ──
// One row per scene per language. Stores the translated script + TTS audio URL.
model SceneTranslation {
  id            String    @id @default(cuid())
  sceneId       String
  scene         VideoScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  lang          String    // language code: "en", "fr", "twi", "ga", "ha", "es", "pt", "ar", "zh"
  langName      String    // display name: "English", "French", "Twi"
  translatedText String?  // translated narration/dialogue text
  narrationUrl  String?   // TTS audio URL in this language
  voiceId       String?   // TTS voice used
  status        String    @default("pending")  // "pending" | "translating" | "generating" | "ready" | "failed"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@unique([sceneId, lang])
  @@index([sceneId])
}

// ── Social Publishing: one-click publish to YouTube/TikTok/Instagram ──
model SocialConnection {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform      String    // "youtube" | "tiktok" | "instagram" | "facebook" | "twitter"
  accountId     String?   // platform's user/channel ID
  accountName   String?   // display name on the platform
  accessToken   String?   // encrypted OAuth access token
  refreshToken  String?   // encrypted OAuth refresh token
  tokenExpiresAt DateTime?
  isConnected   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@unique([userId, platform])
  @@index([userId])
}

model SocialPublish {
  id            String    @id @default(cuid())
  projectId     String
  project       VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform      String    // "youtube" | "tiktok" | "instagram" | "facebook" | "twitter"
  externalId    String?   // post/video ID on the platform
  externalUrl   String?   // public URL on the platform
  title         String?
  description   String?
  status        String    @default("pending")  // "pending" | "uploading" | "published" | "failed"
  errorMessage  String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  @@index([projectId])
  @@index([platform])
}

// ── Template Marketplace: DB-backed industry templates ──
model ProjectTemplate {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String?
  category      String    @default("custom")  // "real-estate" | "restaurant" | "birthday" | "product" | "fitness" | "event" | "education" | "travel"
  style         String    @default("cinematic")
  aspectRatio   String    @default("16:9")
  targetDuration Int      @default(30)
  coverImage    String?
  accentColor   String    @default("from-violet-500 to-fuchsia-500")
  sceneCount    Int       @default(3)
  // JSON array of scene templates: [{ title, prompt, mood, cameraMove, musicMood, duration, transition }]
  sceneTemplates String   @default("[]")
  // JSON array of character templates
  characterTemplates String @default("[]")
  isFeatured    Boolean   @default(false)
  isActive      Boolean   @default(true)
  usageCount    Int       @default(0)  // how many projects created from this template
  sortOrder     Int       @default(0)
  createdBy     String?   // admin user ID who created it
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([isActive, category])
  @@index([isFeatured])
}

// ── Video Analytics: view tracking for shared videos ──
model VideoView {
  id            String    @id @default(cuid())
  projectId     String
  project       VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  viewerId      String?   // anonymous viewer cookie ID
  ipAddress     String?
  userAgent     String?
  referer       String?
  country       String?
  watchDuration Int       @default(0)  // seconds watched
  isComplete    Boolean   @default(false)  // watched to end
  createdAt     DateTime  @default(now())
  @@index([projectId])
  @@index([createdAt])
}

// ── Team Workspaces: shared project spaces for teams ──
model Workspace {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  ownerId       String    // User ID of the workspace owner
  description   String?
  logoUrl       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  members       WorkspaceMember[]
  projects      VideoProject[]
}

model WorkspaceMember {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String    @default("editor")  // "owner" | "admin" | "editor" | "viewer"
  invitedAt     DateTime  @default(now())
  joinedAt      DateTime?
  createdAt     DateTime  @default(now())
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// ── Contact Messages: submissions from the contact form ──
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("General Inquiry")
  message   String
  status    String   @default("new")  // "new" | "read" | "replied" | "archived"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
  @@index([createdAt])
}
