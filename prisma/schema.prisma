generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  name                     String?
  password                 String?
  image                    String?
  role                     String    @default("user")
  tokens                   Int       @default(0)
  isActive                 Boolean   @default(true)
  sessionVersion           Int       @default(0)
  previewDate              String?
  previewStoryboardCount   Int       @default(0)
  previewImageCount        Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  projects                 VideoProject[]
  payments                 Payment[]
  transactions             TokenTransaction[]
  brandKit                 BrandKit?
  socialConnections        SocialConnection[]
  workspaces               WorkspaceMember[]
  longFormProductions      LongFormProduction[]
  mediaAssets              MediaAsset[]
  characterProfiles        CharacterProfile[]
  talkingPhotoJobs         TalkingPhotoJob[]
}

model VideoProject {
  id                 String     @id @default(cuid())
  userId             String?
  user               User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  title              String
  description        String?    @db.Text
  style              String     @default("cinematic")
  aspectRatio        String     @default("16:9")
  status             String     @default("draft")
  targetDuration     Int        @default(60)
  projectType        String     @default("custom")
  videoModel         String?
  narrationLang      String?
  narrationAccent    String?
  narrationStyle     String?
  narrationVoice     String?
  draftData          String?    @db.Text
  lastAutosavedAt    DateTime?
  finalVideoUrl      String?    @db.Text
  cutVersion         Int        @default(0)
  reviewedCutVersion Int?
  reviewedAt         DateTime?
  shareSlug          String?    @unique
  isPublic           Boolean    @default(false)
  sharePassword      String?
  allowEmbed         Boolean    @default(true)
  brandKitId         String?
  brandKit           BrandKit?  @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  workspaceId        String?
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  scenes             VideoScene[]
  characters         Character[]
  views              VideoView[]
  socialPosts        SocialPublish[]
  exportJobs         ExportJob[]
  generationRuns     GenerationRun[]

  @@index([userId])
  @@index([userId, lastAutosavedAt])
  @@index([shareSlug])
}

model VideoScene {
  id                String       @id @default(cuid())
  projectId         String
  project           VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneNumber       Int
  title             String?
  prompt            String       @db.Text
  enhancedPrompt    String?      @db.Text
  visualNote        String?      @db.Text
  dialogue          String?      @db.Text
  characterIds      String?      @db.Text
  referenceImageUrl String?      @db.Text
  narrationUrl      String?      @db.Text
  narrationVoice    String?
  mood              String?
  cameraMove        String?
  lighting          String?
  musicMood         String?
  musicTrackUrl     String?      @db.Text
  musicVolume       Int          @default(30)
  subtitleSrt       String?      @db.Text
  subtitleStatus    String?
  subtitleLang      String?
  burnSubtitles     Boolean      @default(false)
  narrationLang     String?
  narrationAccent   String?
  narrationStyle    String?
  imageUrl          String?      @db.Text
  imageBase64       String?      @db.Text
  videoUrl          String?      @db.Text
  previousVideoUrl  String?      @db.Text
  taskId            String?
  duration          Int          @default(10)
  transition        String       @default("fade")
  status            String       @default("pending")
  errorMessage      String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  translations      SceneTranslation[]

  @@index([projectId])
}

model Character {
  id              String            @id @default(cuid())
  projectId       String
  project         VideoProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceProfileId String?
  sourceProfile   CharacterProfile? @relation(fields: [sourceProfileId], references: [id], onDelete: SetNull)
  name            String
  role            String?
  description     String?           @db.Text
  stylePrompt     String?           @db.Text
  voiceId         String?
  imageUrl        String?           @db.Text
  imageBase64     String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())

  @@index([projectId])
  @@index([sourceProfileId])
}

model MediaAsset {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind              String             @default("image")
  source            String             @default("upload")
  originalName      String
  mimeType          String
  sizeBytes         Int
  url               String             @db.Text
  sha256            String
  width             Int?
  height            Int?
  durationSeconds   Float?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  characterProfiles CharacterProfile[] @relation("CharacterProfilePrimaryAsset")
  talkingPhotoImageJobs TalkingPhotoJob[] @relation("TalkingPhotoImageAsset")
  talkingPhotoAudioJobs TalkingPhotoJob[] @relation("TalkingPhotoAudioAsset")

  @@unique([userId, sha256])
  @@index([userId, createdAt])
}

model CharacterProfile {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  role               String?
  description        String?     @db.Text
  stylePrompt        String?     @db.Text
  voiceId            String?
  primaryAssetId     String?
  primaryAsset       MediaAsset? @relation("CharacterProfilePrimaryAsset", fields: [primaryAssetId], references: [id], onDelete: SetNull)
  referenceAssetIds  String      @default("[]") @db.Text
  performanceProfile String      @default("{}") @db.Text
  consentStatus      String      @default("unconfirmed")
  consentConfirmedAt DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  projectCharacters  Character[]

  @@index([userId, createdAt])
  @@index([primaryAssetId])
}

model TalkingPhotoJob {
  id                  String     @id
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageAssetId        String
  imageAsset          MediaAsset @relation("TalkingPhotoImageAsset", fields: [imageAssetId], references: [id], onDelete: Restrict)
  audioAssetId        String
  audioAsset          MediaAsset @relation("TalkingPhotoAudioAsset", fields: [audioAssetId], references: [id], onDelete: Restrict)
  activeKey           String?    @unique
  status              String     @default("queued")
  durationSeconds     Float
  consentConfirmedAt  DateTime
  billingQuoteId      String?
  creditReservationId String?
  providerTaskId          String?
  videoUrl                String?    @db.Text
  error                   String?    @db.Text
  reconciliationKind      String?
  reconciliationAt        DateTime?
  reconciliationResolution String?   @db.Text
  reconciledAt            DateTime?
  reconciledByUserId      String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([providerTaskId])
  @@index([reconciliationKind, reconciliationAt])
}

model GenerationHistory {
  id        String   @id @default(cuid())
  prompt    String   @db.Text
  inputType String   @default("text")
  style     String?
  createdAt DateTime @default(now())
}

model Payment {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway               String
  gatewayRef            String?
  packageSlug           String?
  amount                Float
  expectedAmountMinor   Int      @default(0)
  currency              String   @default("GHS")
  tokensPurchased       Int
  bonusTokens           Int      @default(0)
  status                String   @default("pending")
  providerTransactionId String?
  settlementKey         String?  @unique
  settledAt             DateTime?
  metadata              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([gateway, gatewayRef])
  @@index([userId])
  @@index([status])
}

model TokenTransaction {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 String
  amount               Int
  description          String   @db.Text
  referenceId          String?
  idempotencyKey       String?  @unique
  relatedTransactionId String?
  costUsd              Float?
  operationType        String?
  createdAt            DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([operationType])
  @@index([referenceId])
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt
}

model TokenPackage {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  tokens    Int
  priceGHS  Float
  priceUSD  Float
  bonusPct  Float    @default(0)
  popular   Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  features  String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model EnginePricing {
  id            String   @id @default(cuid())
  modelId       String   @unique
  priceGHS      Float    @default(0)
  priceUSD      Float    @default(0)
  tokensPerClip Int      @default(3)
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model PricingPlan {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  badge     String?
  priceGHS  Float    @default(0)
  priceUSD  Float    @default(0)
  period    String   @default("month")
  features  String   @default("[]") @db.Text
  ctaLabel  String   @default("Get Started")
  ctaAction String   @default("create")
  highlight Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([isActive, sortOrder])
}

model BrandKit {
  id           String         @id @default(cuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName    String
  logoUrl      String?        @db.Text
  logoPosition String         @default("bottom-right")
  logoOpacity  Int            @default(80)
  logoScale    Int            @default(15)
  primaryColor String?
  tagline      String?        @db.Text
  website      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  projects     VideoProject[]
}

model SceneTranslation {
  id             String     @id @default(cuid())
  sceneId        String
  scene          VideoScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  lang           String
  langName       String
  translatedText String?    @db.Text
  narrationUrl   String?    @db.Text
  voiceId        String?
  status         String     @default("pending")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([sceneId, lang])
  @@index([sceneId])
}

model SocialConnection {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       String
  accountId      String?
  accountName    String?
  accessToken    String?  @db.Text
  refreshToken   String?  @db.Text
  tokenExpiresAt DateTime?
  isConnected    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

model SocialPublish {
  id           String       @id @default(cuid())
  projectId    String
  project      VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform     String
  externalId   String?
  externalUrl  String?      @db.Text
  title        String?
  description  String?      @db.Text
  status       String       @default("pending")
  errorMessage String?      @db.Text
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())

  @@index([projectId])
  @@index([platform])
}

model ProjectTemplate {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  description        String?  @db.Text
  category           String   @default("custom")
  style              String   @default("cinematic")
  aspectRatio        String   @default("16:9")
  targetDuration     Int      @default(30)
  coverImage         String?  @db.Text
  accentColor        String   @default("from-violet-500 to-fuchsia-500")
  sceneCount         Int      @default(3)
  sceneTemplates     String   @default("[]") @db.Text
  characterTemplates String   @default("[]") @db.Text
  isFeatured         Boolean  @default(false)
  isActive            Boolean @default(true)
  usageCount         Int      @default(0)
  sortOrder          Int      @default(0)
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, category])
  @@index([isFeatured])
}

model VideoView {
  id            String       @id @default(cuid())
  projectId     String
  project       VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  viewerId      String?
  ipAddress     String?
  userAgent     String?      @db.Text
  referer       String?      @db.Text
  country       String?
  watchDuration Int          @default(0)
  isComplete    Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  ownerId     String
  description String?           @db.Text
  logoUrl     String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     WorkspaceMember[]
  projects    VideoProject[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("editor")
  invitedAt   DateTime  @default(now())
  joinedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("General Inquiry")
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ExportJob {
  id        String       @id @default(cuid())
  projectId String
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  activeKey String?      @unique
  status    String       @default("queued")
  progress  Int          @default(0)
  step      String       @default("Queued")
  params    String?
  result    String?
  error     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([projectId, createdAt])
  @@index([status, updatedAt])
}

model GenerationRun {
  id                   String       @id @default(cuid())
  projectId            String
  project              VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId               String
  targetSceneId        String?
  sceneIds             String       @default("[]") @db.Text
  activeKey            String?      @unique
  status               String       @default("queued")
  totalTokens          Int
  tokensPerScene       Int
  costUsdPerScene      Float
  chargeTransactionId  String?
  refundTransactionId  String?
  billingQuoteId       String?
  creditReservationId  String?
  error                String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([projectId, createdAt])
  @@index([targetSceneId])
  @@index([status, updatedAt])
}

model ProviderPrice {
  id             String   @id
  provider       String
  model          String
  operation      String
  billingUnit    String
  unitPriceUsd   Float
  unitsPerPrice  Float    @default(1)
  sourceUrl      String   @db.Text
  pricingVersion String
  active         Boolean  @default(true)
  verifiedAt     DateTime
  effectiveFrom  DateTime @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, model, operation])
  @@index([active, verifiedAt])
}

model CommercialPricingPolicy {
  id                       String   @id @default("default")
  creditValueUsd           Float    @default(0.05)
  targetGrossMarginPct     Float    @default(0.35)
  providerSafetyBufferPct  Float    @default(0.05)
  fxSafetyBufferPct        Float    @default(0.05)
  gatewayFeeReservePct     Float    @default(0.03)
  infrastructureReservePct Float    @default(0.03)
  minimumChargeCredits     Int      @default(1)
  priceMaxAgeHours         Int      @default(1080)
  quoteTtlMinutes          Int      @default(15)
  billingEnabled           Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

model BillingQuote {
  id               String             @id
  userId           String
  projectId        String?
  operation        String
  status           String             @default("open")
  pricingVersion   String
  providerCostUsd  Float
  bufferedCostUsd  Float
  customerPriceUsd Float
  creditsRequired  Int
  breakdown        String             @db.Text
  policySnapshot   String             @db.Text
  expiresAt        DateTime           @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  reservation      CreditReservation?

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, expiresAt])
}

model CreditReservation {
  id              String       @id
  userId          String
  quoteId         String       @unique
  quote           BillingQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  referenceId     String?
  operation       String
  reservedCredits Int
  capturedCredits Int          @default(0)
  releasedCredits Int          @default(0)
  status          String       @default("reserved")
  idempotencyKey  String       @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, status])
  @@index([referenceId])
}

model ProviderUsageLedger {
  id               String   @id
  userId           String
  projectId        String?
  sceneId          String?
  generationRunId  String?
  reservationId    String?
  provider         String
  model            String
  operation        String
  billingUnit      String
  quantity         Float
  providerCostUsd  Float
  customerCredits  Int
  customerValueUsd Float
  grossProfitUsd   Float
  grossMarginPct   Float
  providerTaskId   String?
  pricingVersion   String
  status           String   @default("captured")
  idempotencyKey   String   @unique
  submittedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([provider, model])
  @@index([generationRunId])
}

model LongFormProduction {
  id                  String           @id
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  format              String
  title               String
  source              String           @db.Text
  status              String           @default("planned")
  storyBible          String           @db.Text
  totalTargetMinutes  Int
  planningReferenceId String           @unique
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @default(now()) @updatedAt
  seasons             LongFormSeason[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model LongFormSeason {
  id           String             @id
  productionId String
  production   LongFormProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)
  seasonNumber Int
  title        String
  arc          String             @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt
  episodes     LongFormEpisode[]

  @@unique([productionId, seasonNumber])
  @@index([productionId])
}

model LongFormEpisode {
  id                  String             @id
  seasonId            String
  season              LongFormSeason     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeNumber       Int
  title               String
  logline             String             @db.Text
  targetMinutes       Int
  openingHook         String             @db.Text
  emotionalArc        String             @db.Text
  actBeats            String             @db.Text
  payoffOrCliffhanger String             @db.Text
  status              String             @default("planned")
  expansionVersion    Int                @default(0)
  expansionActiveKey  String?            @unique
  expansionClaimedAt  DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  sequences           LongFormSequence[]

  @@unique([seasonId, episodeNumber])
  @@index([seasonId])
  @@index([status, updatedAt])
}

model LongFormSequence {
  id                 String          @id
  episodeId          String
  episode            LongFormEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  sequenceNumber     Int
  title              String
  purpose            String          @db.Text
  startState         String          @db.Text
  endState           String          @db.Text
  targetSeconds      Int
  continuitySnapshot String          @default("{}") @db.Text
  scenePlan          String?         @db.Text
  status             String          @default("planned")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  @@unique([episodeId, sequenceNumber])
  @@index([episodeId])
  @@index([status, updatedAt])
}
