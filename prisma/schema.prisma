generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model VideoProject {
  id             String     @id @default(cuid())
  title          String
  description    String?
  style          String     @default("cinematic")
  aspectRatio    String     @default("16:9")
  status         String     @default("draft")
  targetDuration  Int        @default(60)
  projectType    String     @default("custom")   // custom, birthday, commercial, event, social
  finalVideoUrl  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  scenes         VideoScene[]
  characters     Character[]
}

model VideoScene {
  id             String   @id @default(cuid())
  projectId      String
  project        VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneNumber    Int
  title          String?
  prompt         String
  enhancedPrompt String?
  visualNote     String?                       // extracted visual direction
  dialogue       String?                       // extracted dialogue/narration
  characterIds   String?                       // JSON array of character IDs involved in scene
  referenceImageUrl String?                   // uploaded/generared reference image for scene
  narrationUrl   String?                       // generated TTS narration audio URL
  imageUrl       String?
  imageBase64    String?
  videoUrl       String?
  taskId         String?
  duration       Int      @default(10)
  transition     String   @default("fade")
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([projectId])
}

model Character {
  id             String   @id @default(cuid())
  projectId      String
  project        VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  role           String?                       // protagonist, supporting, narrator, background
  description    String?                       // physical appearance, clothing, personality
  stylePrompt    String?                       // AI-optimized character description for consistency
  imageUrl       String?                       // reference image (uploaded or AI-generated)
  imageBase64    String?                       // for uploaded images stored as base64
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([projectId])
}

model GenerationHistory {
  id          String   @id @default(cuid())
  prompt      String
  inputType   String   @default("text")
  style       String?
  createdAt   DateTime @default(now())
}
