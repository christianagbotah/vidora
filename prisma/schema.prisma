generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  name                     String?
  password                 String?
  image                    String?
  role                     String    @default("user")
  tokens                   Int       @default(0)
  isActive                 Boolean   @default(true)
  sessionVersion           Int       @default(0)
  previewDate              String?
  previewStoryboardCount   Int       @default(0)
  previewImageCount        Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  projects                 VideoProject[]
  payments                 Payment[]
  transactions             TokenTransaction[]
  brandKit                 BrandKit?
  socialConnections        SocialConnection[]
  workspaces               WorkspaceMember[]
}

model VideoProject {
  id                 String     @id @default(cuid())
  userId             String?
  user               User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  title              String
  description        String?    @db.Text
  style              String     @default("cinematic")
  aspectRatio        String     @default("16:9")
  status             String     @default("draft")
  targetDuration     Int        @default(60)
  projectType        String     @default("custom")
  videoModel         String?
  draftData          String?    @db.Text
  lastAutosavedAt    DateTime?
  finalVideoUrl      String?    @db.Text
  cutVersion         Int        @default(0)
  reviewedCutVersion Int?
  reviewedAt         DateTime?
  shareSlug          String?    @unique
  isPublic           Boolean    @default(false)
  sharePassword      String?
  allowEmbed         Boolean    @default(true)
  brandKitId         String?
  brandKit           BrandKit?  @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  workspaceId        String?
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  scenes             VideoScene[]
  characters         Character[]
  views              VideoView[]
  socialPosts        SocialPublish[]
  exportJobs         ExportJob[]
  generationRuns     GenerationRun[]

  @@index([userId])
  @@index([userId, lastAutosavedAt])
  @@index([shareSlug])
}

model VideoScene {
  id                String       @id @default(cuid())
  projectId         String
  project           VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneNumber       Int
  title             String?
  prompt            String       @db.Text
  enhancedPrompt    String?      @db.Text
  visualNote        String?      @db.Text
  dialogue          String?      @db.Text
  characterIds      String?      @db.Text
  referenceImageUrl String?      @db.Text
  narrationUrl      String?      @db.Text
  narrationVoice    String?
  mood              String?
  cameraMove        String?
  lighting          String?
  musicMood         String?
  musicTrackUrl     String?      @db.Text
  musicVolume       Int          @default(30)
  subtitleSrt       String?      @db.Text
  subtitleStatus    String?
  subtitleLang      String?
  burnSubtitles     Boolean      @default(false)
  narrationLang     String?
  imageUrl          String?      @db.Text
  imageBase64       String?      @db.Text
  videoUrl          String?      @db.Text
  previousVideoUrl  String?      @db.Text
  taskId            String?
  duration          Int          @default(10)
  transition        String       @default("fade")
  status            String       @default("pending")
  errorMessage      String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  translations      SceneTranslation[]

  @@index([projectId])
}

model Character {
  id          String       @id @default(cuid())
  projectId   String
  project     VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  role        String?
  description String?      @db.Text
  stylePrompt String?      @db.Text
  voiceId     String?
  imageUrl    String?      @db.Text
  imageBase64 String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now())

  @@index([projectId])
}

model GenerationHistory {
  id        String   @id @default(cuid())
  prompt    String   @db.Text
  inputType String   @default("text")
  style     String?
  createdAt DateTime @default(now())
}

model Payment {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway               String
  gatewayRef            String?
  packageSlug           String?
  amount                Float
  expectedAmountMinor   Int      @default(0)
  currency              String   @default("GHS")
  tokensPurchased       Int
  bonusTokens           Int      @default(0)
  status                String   @default("pending")
  providerTransactionId String?
  settlementKey         String?  @unique
  settledAt             DateTime?
  metadata              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([gateway, gatewayRef])
  @@index([userId])
  @@index([status])
}

model TokenTransaction {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 String
  amount               Int
  description          String   @db.Text
  referenceId          String?
  idempotencyKey       String?  @unique
  relatedTransactionId String?
  costUsd              Float?
  operationType        String?
  createdAt            DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([operationType])
  @@index([referenceId])
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt
}

model TokenPackage {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  tokens    Int
  priceGHS  Float
  priceUSD  Float
  bonusPct  Float    @default(0)
  popular   Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  features  String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model EnginePricing {
  id            String   @id @default(cuid())
  modelId       String   @unique
  priceGHS      Float    @default(0)
  priceUSD      Float    @default(0)
  tokensPerClip Int      @default(3)
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model PricingPlan {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  badge     String?
  priceGHS  Float    @default(0)
  priceUSD  Float    @default(0)
  period    String   @default("month")
  features  String   @default("[]") @db.Text
  ctaLabel  String   @default("Get Started")
  ctaAction String   @default("create")
  highlight Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([isActive, sortOrder])
}

model BrandKit {
  id           String         @id @default(cuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName    String
  logoUrl      String?        @db.Text
  logoPosition String         @default("bottom-right")
  logoOpacity  Int            @default(80)
  logoScale    Int            @default(15)
  primaryColor String?
  tagline      String?        @db.Text
  website      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  projects     VideoProject[]
}

model SceneTranslation {
  id             String     @id @default(cuid())
  sceneId        String
  scene          VideoScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  lang           String
  langName       String
  translatedText String?    @db.Text
  narrationUrl   String?    @db.Text
  voiceId        String?
  status         String     @default("pending")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([sceneId, lang])
  @@index([sceneId])
}

model SocialConnection {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       String
  accountId      String?
  accountName    String?
  accessToken    String?  @db.Text
  refreshToken   String?  @db.Text
  tokenExpiresAt DateTime?
  isConnected    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

model SocialPublish {
  id           String       @id @default(cuid())
  projectId    String
  project      VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform     String
  externalId   String?
  externalUrl  String?      @db.Text
  title        String?
  description  String?      @db.Text
  status       String       @default("pending")
  errorMessage String?      @db.Text
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())

  @@index([projectId])
  @@index([platform])
}

model ProjectTemplate {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  description        String?  @db.Text
  category           String   @default("custom")
  style              String   @default("cinematic")
  aspectRatio        String   @default("16:9")
  targetDuration     Int      @default(30)
  coverImage         String?  @db.Text
  accentColor        String   @default("from-violet-500 to-fuchsia-500")
  sceneCount         Int      @default(3)
  sceneTemplates     String   @default("[]") @db.Text
  characterTemplates String   @default("[]") @db.Text
  isFeatured         Boolean  @default(false)
  isActive           Boolean  @default(true)
  usageCount         Int      @default(0)
  sortOrder          Int      @default(0)
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, category])
  @@index([isFeatured])
}

model VideoView {
  id            String       @id @default(cuid())
  projectId     String
  project       VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  viewerId      String?
  ipAddress     String?
  userAgent     String?      @db.Text
  referer       String?      @db.Text
  country       String?
  watchDuration Int          @default(0)
  isComplete    Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  ownerId     String
  description String?           @db.Text
  logoUrl     String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     WorkspaceMember[]
  projects    VideoProject[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("editor")
  invitedAt   DateTime  @default(now())
  joinedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("General Inquiry")
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ExportJob {
  id        String       @id @default(cuid())
  projectId String
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  activeKey String?      @unique
  status    String       @default("queued")
  progress  Int          @default(0)
  step      String       @default("Queued")
  params    String?
  result    String?
  error     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([projectId, createdAt])
  @@index([status, updatedAt])
}

model GenerationRun {
  id                   String       @id @default(cuid())
  projectId            String
  project              VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId               String
  targetSceneId        String?
  sceneIds             String       @default("[]") @db.Text
  activeKey            String?      @unique
  status               String       @default("queued")
  totalTokens          Int
  tokensPerScene       Int
  costUsdPerScene      Float
  chargeTransactionId  String?
  refundTransactionId  String?
  error                String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([projectId, createdAt])
  @@index([targetSceneId])
  @@index([status, updatedAt])
}
