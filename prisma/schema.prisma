generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   // bcrypt hash for credentials auth
  image         String?
  role          String    @default("user")  // "user" | "admin"
  tokens        Int       @default(0)      // credit/token balance
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      VideoProject[]
  payments      Payment[]
  transactions  TokenTransaction[]
}

model VideoProject {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  title          String
  description    String?    
  style          String     @default("cinematic")
  aspectRatio    String     @default("16:9")
  status         String     @default("draft")
  targetDuration  Int        @default(60)
  projectType    String     @default("custom")   // custom, birthday, commercial, event, social
  finalVideoUrl  String?    
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  scenes         VideoScene[]
  characters     Character[]
  @@index([userId])
}

model VideoScene {
  id             String   @id @default(cuid())
  projectId      String
  project        VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneNumber    Int
  title          String?
  prompt         String    
  enhancedPrompt String?  
  visualNote     String?                        // extracted visual direction
  dialogue       String?                        // extracted dialogue/narration
  characterIds   String?                        // JSON array of character IDs involved in scene
  referenceImageUrl String?                    // uploaded/generated reference image for scene
  narrationUrl   String?                        // generated TTS narration audio URL
  narrationVoice String?                       // which TTS voice was used
  mood           String?                       // emotional mood of the scene (dramatic, happy, dark, etc.)
  cameraMove     String?                       // camera movement directive (zoom_in, pan_left, tracking, etc.)
  musicMood      String?                       // background music mood (epic, calm, tense, joyful)
  imageUrl       String?                       
  imageBase64    String?                       
  videoUrl       String?                       
  taskId         String?
  duration       Int      @default(10)
  transition     String   @default("fade")
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([projectId])
}

model Character {
  id             String   @id @default(cuid())
  projectId      String
  project        VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  role           String?                       // protagonist, supporting, narrator, background
  description    String?                        // physical appearance, clothing, personality
  stylePrompt    String?                        // AI-optimized character description for consistency
  voiceId        String?                       // assigned TTS voice ID for this character
  imageUrl       String?                        // reference image (uploaded or AI-generated)
  imageBase64    String?                        // for uploaded images stored as base64
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([projectId])
}

model GenerationHistory {
  id          String   @id @default(cuid())
  prompt      String   
  inputType   String   @default("text")
  style       String?
  createdAt   DateTime @default(now())
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway         String    // "paystack" | "hubtel" | "stripe"
  gatewayRef      String?   // reference/transaction ID from payment gateway
  amount          Float     // amount paid
  currency        String    @default("GHS")  // "GHS" | "USD"
  tokensPurchased Int       // number of tokens bought
  status          String    @default("pending")  // "pending" | "completed" | "failed" | "refunded"
  metadata        String?    // JSON string for gateway-specific data
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([userId])
}

model TokenTransaction {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String    // "purchase" | "spend" | "refund" | "bonus"
  amount        Int       // positive = credit, negative = debit
  description   String
  referenceId   String?   // payment ID or project ID
  createdAt     DateTime  @default(now())
  @@index([userId])
}

model SystemConfig {
  id            String    @id @default(cuid())
  key           String    @unique
  value         String    
  description   String?   
  updatedAt     DateTime  @updatedAt
}
