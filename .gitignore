# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*

# AI/Sandbox configs
.claude
.z-ai-config

# Logs
*.log
dev.log
dev.out.log
server.log

# Skills directory
/skills/

# Vidora-specific ignores
/db/
/tool-results/
/tests/
/examples/
/screenshots/
/download/
/write_page.py

# Local PostgreSQL data directory (environment-specific, not source code)
/pgdata/

# Test screenshots and generated assets (too large for git)
screenshot*.png
homepage.png
create-page.png
enhance-result.png
enhance-toast.png
*-result.png
*-toast.png

# AI generated images/videos (regenerated at runtime)
/public/generated/

# Mini services (if any)
/mini-services/

# Auto-commit script log
/auto-git.log
~/.github_token
