# ───────────────────────────────────────────────────────────────────────────
#  Vidora — Environment Variables Template
# ───────────────────────────────────────────────────────────────────────────
#
#  Copy this file to `.env` and fill in real values.
#    cp .env.example .env
#
#  NEVER commit the real `.env` — it is gitignored and must stay that way.
#  This template contains NO secrets and is safe to commit.
# ───────────────────────────────────────────────────────────────────────────

# ── Database ──
# Local dev: SQLite
DATABASE_URL="file:./db/custom.db"
# Production (VPS): PostgreSQL
# DATABASE_URL="postgresql://user:password@localhost:5432/vidora_db?schema=public"

# ── NextAuth.js ──
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Z.ai SDK (AI generation: video, image, TTS, LLM, dubbing) ──
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
ZAI_API_KEY="your-zai-api-key-here"

# ── Payment Gateways (all optional — only enable the ones you use) ──
# Paystack (Ghana/Nigeria)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Hubtel (Ghana)
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""
HUBTEL_MERCHANT_ACCOUNT=""
HUBTEL_MERCHANT_ID=""
# Stripe (international)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Legacy AI keys (kept for backward compat; ZAI_* above is preferred) ──
IMAGE_API_KEY=""
VIDEO_API_KEY=""
TTS_API_KEY=""

# ── Email (optional — used for receipts / notifications) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
