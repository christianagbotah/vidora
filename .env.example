# ═════════════════════════════════════════
# Vidora — Environment Variables
# ═════════════════════════════════════════

# ── Database (PostgreSQL) ──
DATABASE_URL="postgresql://vidora_user:YOUR_PASSWORD@localhost:5432/vidora_db?schema=public"

# ── NextAuth ──
NEXTAUTH_URL="http://your-domain.com"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# ── Payment Gateways ──
# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY="sk_test_xxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxx"

# Hubtel (https://hubtel.com)
HUBTEL_CLIENT_ID="xxxx"
HUBTL_CLIENT_SECRET="xxxx"
HUBTEL_MERCHANT_ACCOUNT="xxxx"

# Stripe (https://stripe.com)
STRIPE_SECRET_KEY="sk_test_xxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxx"

# ── AI Services ──
# Image Generation (e.g. stability.ai, replicate, etc.)
IMAGE_API_KEY="your-image-api-key"

# Video Generation
VIDEO_API_KEY="your-video-api-key"

# TTS (Text-to-Speech)
TTS_API_KEY="your-tts-api-key"

# ── Optional: Email ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
