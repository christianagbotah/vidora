# ═════════════════════════════════════════
# Vidora — Environment Variables
# Copy to .env on the server and replace EVERY CHANGE_ME value.
# Never commit the populated .env file.
# ═════════════════════════════════════════

# ── Database (PostgreSQL) ──
DATABASE_URL="postgresql://vidora_db_user:CHANGE_ME_DB_PASSWORD@localhost:5432/vidora_db?schema=public"

# ── NextAuth ──
NEXTAUTH_URL="https://vidora.lightworldtech.com"
NEXT_PUBLIC_BASE_URL="https://vidora.lightworldtech.com"
# Generate independently, e.g. openssl rand -base64 48. Minimum 32 chars.
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET"

# Protects any legacy DB-backed encrypted configuration values.
# Generate 32 random bytes, e.g. openssl rand -hex 32.
CONFIG_ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARACTERS"

# ── Payment Gateways ──
# Provider secrets are environment-managed and write-disabled in the web admin.
PAYSTACK_SECRET_KEY="CHANGE_ME_PAYSTACK_SECRET"
PAYSTACK_PUBLIC_KEY="CHANGE_ME_PAYSTACK_PUBLIC"

HUBTEL_CLIENT_ID="CHANGE_ME_HUBTEL_CLIENT_ID"
HUBTEL_CLIENT_SECRET="CHANGE_ME_HUBTEL_CLIENT_SECRET"
HUBTEL_MERCHANT_ACCOUNT_NUMBER="CHANGE_ME_HUBTEL_COLLECTION_ACCOUNT"

STRIPE_SECRET_KEY="CHANGE_ME_STRIPE_SECRET"
STRIPE_WEBHOOK_SECRET="CHANGE_ME_STRIPE_WEBHOOK_SECRET"

# ── AI Services ──
# Global Z.ai route used by Vidora chat/image/video.
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
ZAI_API_KEY="CHANGE_ME_ZAI_API_KEY"
ZAI_CHAT_MODEL="glm-4-plus"

# GLM-TTS is served by the BigModel/Open Platform speech endpoint, not the
# global api.z.ai route above. Keep the credentials separate so changing voice
# configuration cannot break Vidora's working video/chat integration.
ZAI_TTS_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZAI_TTS_API_KEY="CHANGE_ME_BIGMODEL_TTS_API_KEY"
ZAI_TTS_MODEL="glm-tts"

# ── Email / Password Reset ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="CHANGE_ME_SMTP_USER"
SMTP_PASSWORD="CHANGE_ME_SMTP_APP_PASSWORD"
SMTP_FROM="CHANGE_ME_FROM_ADDRESS"

# ── Runtime storage / backups ──
GENERATED_DIR="/home/lightworld/webapps/vidora/generated-store"
BACKUP_DIR="/home/lightworld/backups/vidora"

# Backup safety policy. These are optional; deploy.sh uses these defaults when
# omitted. Retention runs only after a fully healthy deploy and prunes only old
# healthy manifest-backed recovery sets. Prepared/failed-deploy sets and
# emergency rollback snapshots are never automatically deleted.
BACKUP_RETENTION_SETS="5"
# Required free space is max((media bytes + live DB bytes) * (1 + headroom),
# BACKUP_MIN_FREE_GB). Deploy fails before writing a backup if this is not met.
BACKUP_SPACE_HEADROOM_PERCENT="25"
BACKUP_MIN_FREE_GB="5"

# Optional legacy keys. Leave unset unless an old deployment still requires them.
IMAGE_API_KEY=""
VIDEO_API_KEY=""
TTS_API_KEY=""
