# ═════════════════════════════════════════
# Vidora — Environment Variables
# ═════════════════════════════════════════

# ── Database (PostgreSQL) ──
DATABASE_URL="postgresql://lightworld_db_user:myjesus4mE2018@localhost:5432/lightworld_vidora_db?schema=public"

# ── NextAuth ──
NEXTAUTH_URL="https://vidora.lightworldtech.com"
NEXTAUTH_SECRET="vidora-secret-change-in-production-2024"
NEXT_PUBLIC_BASE_URL="https://vidora.lightworldtech.com"

# ── Payment Gateways ──
# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY="sk_test_xxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxx"

# Hubtel Online Checkout (https://developers.hubtel.com)
# API: https://payproxyapi.hubtel.com/items/initiate
# Status: https://api-txnstatus.hubtel.com/transactions/{account}/status
HUBTEL_CLIENT_ID="xxxx"
HUBTEL_CLIENT_SECRET="xxxx"
HUBTEL_MERCHANT_ACCOUNT_NUMBER="xxxx"  # Collection Account Number (e.g. 11684)

# Stripe (https://stripe.com)
STRIPE_SECRET_KEY="sk_test_xxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxx"

# ── AI Services ──
# Z.ai SDK (LLM, image gen, video gen, TTS, ASR)
# These override the .z-ai-config file lookup — REQUIRED for production
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
ZAI_API_KEY="your-zai-api-key-here"

# Legacy keys (unused — kept for backward compat)
IMAGE_API_KEY="your-image-api-key"
VIDEO_API_KEY="your-video-api-key"
TTS_API_KEY="your-tts-api-key"

# ── Optional: Email ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
